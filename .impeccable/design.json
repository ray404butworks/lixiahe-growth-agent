  "narrative": {
    "northStar": "中性浅色系统工作台",
    "overview": "按 Ray 明确指定的 Apple Developer Console / macOS 设置式方向实现。浅灰画布、白色分组、石墨黑操作与系统字体共同提供稳定、清楚的经营界面；蓝色只承担链接、焦点和选框的识别。保留垛田标志轮廓，以低饱和灰橄榄绿（#78866B）单色版本保留稻田意象并融入工作台。\n\n以任务、数据和真实状态建立层级。密度通过留白、分组和文字层级调节，不以大面积品牌色、聊天气泡或装饰效果填充页面。此文件记录当前已实现的视觉系统；产品能力和约束见 `PRODUCT.md`，页面任务见对应 surface brief。",
    "keyCharacteristics": [
      "中性浅色表面，清晰但克制的分组。",
      "系统字体、紧凑正文、稳定的数字对齐。",
      "石墨黑主操作、蓝色链接与键盘焦点、保留语义状态色。",
      "桌面侧栏与手机可展开导航共用六个入口。"
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "section": "colors",
        "body": "品牌不占用成功色。状态色必须传达实际状态，不能代替状态文字。"
      },
      {
        "name": "The Complete Number Rule",
        "section": "typography",
        "body": "金额、百分比和单位应保持可核对；报告宽表通过局部滚动保留完整数字，不把小数末位挤成孤立一行。"
      },
      {
        "name": "The Quiet Surface Rule",
        "section": "elevation",
        "body": "新分组沿用表面与边线的层级，不为普通业务卡片增加装饰性投影。"
      }
    ],
    "dos": [
      "**Do** 从 `globals.css` 取语义 tokens，通过 `workspace.css` 维护共享组件，页面样式只表达布局差异。",
      "**Do** 延续系统字体、中性分组、石墨主按钮和蓝色可交互提示。",
      "**Do** 保留完整数字、字段核对、错误反馈、来源与授权状态。",
      "**Do** 为桌面和手机保留同一套六入口导航，并将宽表滚动限制在局部。",
      "**Do** 将署名留在正常文档流并在打印时隐藏。"
    ],
    "donts": [
      "**Don't** 恢复稻米白、深田绿的旧视觉主题，或用大面积绿色提示替代信息层级。",
      "**Don't** 添加渐变、玻璃、发光、装饰图片或普通卡片悬浮阴影。",
      "**Don't** 引入下载字体、外部字体请求或为本次视觉方向新增依赖。",
      "**Don't** 把截图验证视口误写成 CSS 断点，或把独立视觉复核当成人工验收与发布许可。"
    ]
  }
}
