{
  "name": "lixiahe-growth-agent",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/build-core.mjs && node scripts/build-agent.mjs",
    "build": "next build",
    "build:export": "NEXT_OUTPUT_MODE=export pnpm build",
    "build:github-pages": "NEXT_PUBLIC_BASE_PATH=/$(basename $(git rev-parse --show-toplevel)) NEXT_OUTPUT_MODE=export pnpm build",
    "check": "eslint src --ext .ts,.tsx && tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "test:e2e": "playwright test --config playwright.growth.config.ts",
    "test:all": "pnpm --filter csv-charts-ai test && pnpm test",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "predev": "node scripts/build-core.mjs && node scripts/build-agent.mjs",
    "pretest": "node scripts/build-core.mjs",
    "demo:generate": "node scripts/generate-demo-data.mjs",
    "test:e2e:growth": "playwright test --config playwright.growth.config.ts",
    "benchmark:growth": "node scripts/benchmark-growth.mjs",
    "agent:build": "node scripts/build-agent.mjs",
    "preview:local": "node scripts/serve-preview.mjs",
    "test:phase3": "vitest run src/lib/agent src/app/_components/agent-workbench.test.tsx",
    "smoke:phase3": "node scripts/smoke-phase3.mjs"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.10",
    "csv-charts-ai": "workspace:*",
    "lucide-react": "^0.577.0",
    "next": "^16.4.5",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.5.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "read-excel-file": "^7.0.2",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@11.25.0"
}
